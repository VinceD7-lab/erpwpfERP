root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 4
insert_final_newline = true
trim_trailing_whitespace = true

[*.{json,yml,yaml,csproj,props,xml,cshtml,css,js}]
indent_size = 2

[*.{cshtml}]
indent_size = 4

[*.md]
trim_trailing_whitespace = false

[*.{sln,ps1}]
end_of_line = crlf

[*.cs]
# Organisation des usings
dotnet_sort_system_directives_first = true
dotnet_separate_import_directive_groups = false
csharp_using_directive_placement = outside_namespace:warning

# Espaces de noms et style
csharp_style_namespace_declarations = file_scoped:warning
csharp_style_var_for_built_in_types = true:suggestion
csharp_style_var_when_type_is_apparent = true:suggestion
csharp_style_var_elsewhere = true:suggestion
csharp_prefer_braces = true:warning
csharp_style_expression_bodied_methods = when_on_single_line:suggestion
csharp_style_prefer_primary_constructors = true:suggestion
dotnet_style_readonly_field = true:warning
dotnet_style_qualification_for_field = false:warning
dotnet_style_qualification_for_property = false:warning
dotnet_style_qualification_for_method = false:warning

# Mise en forme
csharp_new_line_before_open_brace = all
csharp_new_line_before_else = true
csharp_new_line_before_catch = true
csharp_new_line_before_finally = true
csharp_indent_case_contents = true
csharp_space_after_keywords_in_control_flow_statements = true

# ---- Conventions de nommage (STUPID : Indescriptive Naming) ----

dotnet_naming_symbols.interfaces.applicable_kinds = interface
dotnet_naming_style.prefixe_i.required_prefix = I
dotnet_naming_style.prefixe_i.capitalization = pascal_case
dotnet_naming_rule.interfaces_prefixees_par_i.symbols = interfaces
dotnet_naming_rule.interfaces_prefixees_par_i.style = prefixe_i
dotnet_naming_rule.interfaces_prefixees_par_i.severity = warning

dotnet_naming_symbols.types.applicable_kinds = class, struct, enum, delegate
dotnet_naming_symbols.membres_publics.applicable_kinds = property, method, event
dotnet_naming_style.pascal.capitalization = pascal_case
dotnet_naming_rule.types_en_pascal.symbols = types
dotnet_naming_rule.types_en_pascal.style = pascal
dotnet_naming_rule.types_en_pascal.severity = warning
dotnet_naming_rule.membres_en_pascal.symbols = membres_publics
dotnet_naming_rule.membres_en_pascal.style = pascal
dotnet_naming_rule.membres_en_pascal.severity = warning

dotnet_naming_symbols.methodes_asynchrones.applicable_kinds = method
dotnet_naming_symbols.methodes_asynchrones.required_modifiers = async
dotnet_naming_style.suffixe_async.required_suffix = Async
dotnet_naming_style.suffixe_async.capitalization = pascal_case
dotnet_naming_rule.methodes_asynchrones_suffixees.symbols = methodes_asynchrones
dotnet_naming_rule.methodes_asynchrones_suffixees.style = suffixe_async
dotnet_naming_rule.methodes_asynchrones_suffixees.severity = warning

dotnet_naming_symbols.champs_prives.applicable_kinds = field
dotnet_naming_symbols.champs_prives.applicable_accessibilities = private
dotnet_naming_style.prefixe_souligne.required_prefix = _
dotnet_naming_style.prefixe_souligne.capitalization = camel_case
dotnet_naming_rule.champs_prives_prefixes.symbols = champs_prives
dotnet_naming_rule.champs_prives_prefixes.style = prefixe_souligne
dotnet_naming_rule.champs_prives_prefixes.severity = warning

dotnet_naming_symbols.constantes.applicable_kinds = field
dotnet_naming_symbols.constantes.required_modifiers = const
dotnet_naming_rule.constantes_en_pascal.symbols = constantes
dotnet_naming_rule.constantes_en_pascal.style = pascal
dotnet_naming_rule.constantes_en_pascal.severity = warning

# Actions MVC : le nom de l'action est l'URL (ASP.NET Core retire le suffixe Async), pas de suffixe imposé
[src/erpWeb.Web/Controllers/*.cs]
dotnet_naming_rule.methodes_asynchrones_suffixees.severity = none

# Les migrations EF Core sont générées : pas d'analyse de style
[**/Migrations/*.cs]
generated_code = true
