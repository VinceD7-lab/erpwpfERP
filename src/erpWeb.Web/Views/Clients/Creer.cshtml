@model erpWeb.Core.Clients.CreationClientDto
@{
    ViewData["Title"] = "Nouveau client";
}

<en-tete-page titre="Nouveau client">
    <a asp-action="Index" class="btn btn-outline-secondary"><i class="bi bi-arrow-left me-1" aria-hidden="true"></i>Retour</a>
</en-tete-page>

<div class="row">
    <div class="col-12 col-lg-8 col-xl-6">
        <div class="card shadow-sm">
            <div class="card-body">
                <form asp-action="Creer" method="post">
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>
                    <partial name="_ChampsClient" model="Model" />
                    <button type="submit" class="btn btn-primary">Créer le client</button>
                </form>
            </div>
        </div>
    </div>
</div>
