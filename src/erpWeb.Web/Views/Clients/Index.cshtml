@model IReadOnlyList<erpWeb.Core.Clients.ClientDto>
@{
    ViewData["Title"] = "Clients";
}

<en-tete-page titre="Clients">
    <a asp-action="Creer" class="btn btn-primary" asp-permission="@Permissions.Clients.Gerer">
        <i class="bi bi-plus-lg me-1" aria-hidden="true"></i>Nouveau client
    </a>
</en-tete-page>

<div class="card shadow-sm">
    <div class="card-body">
        @* Jeton lu par l'édition de ligne (site.js) et envoyé dans l'en-tête RequestVerificationToken. *@
        @Html.AntiForgeryToken()
        <div data-messages-ligne aria-live="polite"></div>
        <div class="table-responsive">
            <table class="table table-hover align-middle w-100" data-tableau data-hauteur-defilement="29rem">
                <thead>
                    <tr>
                        <th scope="col">Raison sociale</th>
                        <th scope="col">Code postal</th>
                        <th scope="col">Ville</th>
                        <th scope="col">Pays</th>
                        <th scope="col">Téléphone</th>
                        <th scope="col">Email</th>
                        <th scope="col" class="text-end" data-orderable="false">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var client in Model)
                    {
                        <partial name="_LigneClient" model="client" />
                    }
                </tbody>
            </table>
        </div>

        @* Détail du client sélectionné (clic sur une ligne, site.js) puis ses échantillons. *@
        <section data-detail-client data-url-detail="@Url.Action("Detail")" hidden>
            <hr class="my-4" />
            <div data-detail-client-contenu aria-live="polite"></div>

            <div asp-permission="@Permissions.Echantillons.Lire">
                <hr class="my-4" />
                <h3 class="h6">Échantillons du client</h3>
                @* Le template Vue est dans wwwroot/js/composants/tableau-echantillons-client.js. *@
                <div data-composant-vue="tableau-echantillons-client"
                     data-url-donnees="@Url.Action("Resultats", "Echantillons")"
                     data-taille-page="10">
                    <p class="small text-body-secondary" role="status">Chargement des échantillons…</p>
                </div>
            </div>
        </section>
    </div>
</div>

@section Styles {
    <link rel="stylesheet" href="~/lib/tabulator/dist/css/tabulator_bootstrap5.min.css" />
}

@section Scripts {
    <script src="~/lib/tabulator/dist/js/tabulator.min.js"></script>
    <partial name="_ScriptsVue" />
}
