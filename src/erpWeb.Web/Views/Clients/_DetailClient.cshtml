@model erpWeb.Core.Clients.ClientDto

<div class="d-flex justify-content-between align-items-start gap-2 mb-3">
    <h2 class="h5 mb-0">@Model.RaisonSociale</h2>
    <a asp-action="Modifier" asp-route-id="@Model.Id" class="btn btn-sm btn-outline-secondary" asp-permission="@Permissions.Clients.Gerer">
        <i class="bi bi-pencil me-1" aria-hidden="true"></i>Modifier
    </a>
</div>

<dl class="row mb-0">
    <dt class="col-sm-3 col-lg-2">Adresse</dt>
    <dd class="col-sm-9 col-lg-4">
        @Model.Adresse1
        @if (!string.IsNullOrEmpty(Model.Adresse2))
        {
            <br />@Model.Adresse2
        }
        @if (!string.IsNullOrEmpty(Model.CodePostal) || !string.IsNullOrEmpty(Model.Ville))
        {
            <br />@($"{Model.CodePostal} {Model.Ville}".Trim())
        }
        @if (!string.IsNullOrEmpty(Model.Pays))
        {
            <br />@Model.Pays
        }
    </dd>

    <dt class="col-sm-3 col-lg-2">Téléphone</dt>
    <dd class="col-sm-9 col-lg-4">
        @Model.Telephone1
        @if (!string.IsNullOrEmpty(Model.Telephone2))
        {
            <br />@Model.Telephone2
        }
    </dd>

    <dt class="col-sm-3 col-lg-2">Email</dt>
    <dd class="col-sm-9 col-lg-4 text-break">
        @if (!string.IsNullOrEmpty(Model.Email))
        {
            <a href="mailto:@Model.Email">@Model.Email</a>
        }
    </dd>
</dl>
