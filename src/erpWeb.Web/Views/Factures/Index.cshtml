@using System.Text.Json
@using erpWeb.Core.Autorisation
@using erpWeb.Core.Clients
@model IReadOnlyList<ClientDto>
@{
    ViewData["Title"] = "Factures";
    var clients = JsonSerializer.Serialize(Model.Select(client => new { client.Id, client.RaisonSociale }));
}

<en-tete-page titre="Factures des échantillons">
    <form asp-action="Generer" method="post" asp-permission="@Permissions.Factures.Generer">
        <button type="submit" class="btn btn-primary"><i class="bi bi-arrow-repeat me-1" aria-hidden="true"></i>Générer les factures manquantes</button>
    </form>
</en-tete-page>

<div class="card shadow-sm">
    <div class="card-body">
        @* Le template Vue est dans wwwroot/js/composants/tableau-factures.js : pas de syntaxe Vue en Razor. *@
        <div data-composant-vue="tableau-factures"
             data-url-donnees="@Url.Action("Resultats")"
             data-url-impression="@Url.Action("Imprimer")"
             data-clients="@clients"
             data-taille-page="25">
            <p class="small text-body-secondary" role="status">Chargement des factures…</p>
        </div>
    </div>
</div>

@section Styles {
    <link rel="stylesheet" href="~/lib/tabulator/dist/css/tabulator_bootstrap5.min.css" />
}

@section Scripts {
    <script src="~/lib/tabulator/dist/js/tabulator.min.js"></script>
    <partial name="_ScriptsVue" />
}
