@{
    ViewData["Title"] = "Journal d'audit";
}

<en-tete-page titre="Journal d'audit">
    <a asp-action="Exporter" class="btn btn-outline-success" asp-permission="@Permissions.JournalAudit.Exporter">
        <i class="bi bi-file-earmark-excel me-1" aria-hidden="true"></i>Exporter (Excel)
    </a>
</en-tete-page>

<div class="card shadow-sm">
    <div class="card-body">
        @* Le template Vue est dans wwwroot/js/composants/tableau-journal-audit.js : pas de syntaxe Vue en Razor. *@
        <div data-composant-vue="tableau-journal-audit"
             data-url-donnees="@Url.Action("Entrees")"
             data-taille-page="25">
            <p class="small text-body-secondary" role="status">Chargement du journal…</p>
        </div>
    </div>
</div>

@section Styles {
    <link rel="stylesheet" href="~/lib/tabulator/dist/css/tabulator_bootstrap5.min.css" />
}

@section Scripts {
    <script src="~/lib/tabulator/dist/js/tabulator.min.js"></script>
    <partial name="_ScriptsVue" />
}
