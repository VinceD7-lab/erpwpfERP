@if (TempData[CleMessages.Succes] is string succes)
{
    <div class="alert alert-success alert-dismissible fade show" role="status">
        <i class="bi bi-check-circle me-2" aria-hidden="true"></i>@succes
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Fermer"></button>
    </div>
}
@if (TempData[CleMessages.Erreur] is string erreur)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        <i class="bi bi-exclamation-triangle me-2" aria-hidden="true"></i>@erreur
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Fermer"></button>
    </div>
}
