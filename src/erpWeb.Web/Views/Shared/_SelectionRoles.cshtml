@model SelectionRolesViewModel
<fieldset class="mb-3">
    <legend class="form-label fs-6">Rôles</legend>
    @foreach (var role in Model.RolesDisponibles)
    {
        <div class="form-check">
            <input class="form-check-input" type="checkbox" name="Roles" value="@role" id="role-@role" checked="@Model.RolesSelectionnes.Contains(role)" />
            <label class="form-check-label" for="role-@role">@role</label>
        </div>
    }
</fieldset>
