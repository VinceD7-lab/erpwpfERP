@model erpWeb.Core.Utilisateurs.CreationUtilisateurDto
@{
    ViewData["Title"] = "Nouvel utilisateur";
    var rolesDisponibles = (IReadOnlyList<string>?)ViewData[erpWeb.Web.Controllers.UtilisateursController.CleRolesDisponibles] ?? [];
}

<en-tete-page titre="Nouvel utilisateur">
    <a asp-action="Index" class="btn btn-outline-secondary"><i class="bi bi-arrow-left me-1" aria-hidden="true"></i>Retour</a>
</en-tete-page>

<div class="row">
    <div class="col-12 col-lg-8 col-xl-6">
        <div class="card shadow-sm">
            <div class="card-body">
                <form asp-action="Creer" method="post">
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>
                    <div class="mb-3">
                        <label asp-for="NomComplet" class="form-label">Nom complet</label>
                        <input asp-for="NomComplet" class="form-control" required />
                    </div>
                    <div class="mb-3">
                        <label asp-for="Email" class="form-label">Email</label>
                        <input asp-for="Email" type="email" class="form-control" required />
                    </div>
                    <div class="mb-3">
                        <label asp-for="MotDePasse" class="form-label">Mot de passe initial</label>
                        <input asp-for="MotDePasse" type="password" class="form-control" autocomplete="new-password" required />
                    </div>
                    <partial name="_SelectionRoles" model="new SelectionRolesViewModel(rolesDisponibles, Model.Roles)" />
                    <button type="submit" class="btn btn-primary">Créer l'utilisateur</button>
                </form>
            </div>
        </div>
    </div>
</div>
