{
  "version": "3.0",
  "defaultProvider": "jsdelivr",
  "libraries": [
    {
      "library": "bootstrap@5.3.8",
      "destination": "wwwroot/lib/bootstrap/",
      "files": [ "dist/css/bootstrap.min.css", "dist/js/bootstrap.bundle.min.js" ]
    },
    {
      "library": "bootstrap-icons@1.11.3",
      "destination": "wwwroot/lib/bootstrap-icons/",
      "files": [ "font/bootstrap-icons.min.css", "font/fonts/bootstrap-icons.woff", "font/fonts/bootstrap-icons.woff2" ]
    },
    {
      "library": "jquery@3.7.1",
      "destination": "wwwroot/lib/jquery/",
      "files": [ "dist/jquery.min.js" ]
    },
    {
      "library": "jquery-validation@1.22.1",
      "destination": "wwwroot/lib/jquery-validation/",
      "files": [ "dist/jquery.validate.min.js" ]
    },
    {
      "library": "jquery-validation-unobtrusive@4.0.0",
      "destination": "wwwroot/lib/jquery-validation-unobtrusive/",
      "files": [ "dist/jquery.validate.unobtrusive.min.js" ]
    },
    {
      "library": "datatables.net@3.0.4",
      "destination": "wwwroot/lib/datatables.net/",
      "files": [ "js/dataTables.min.js" ]
    },
    {
      "library": "datatables.net-bs5@3.0.4",
      "destination": "wwwroot/lib/datatables.net-bs5/",
      "files": [ "css/dataTables.bootstrap5.min.css", "js/dataTables.bootstrap5.min.js" ]
    },
    {
      "library": "chart.js@4.5.1",
      "destination": "wwwroot/lib/chart.js/",
      "files": [ "dist/chart.umd.js" ]
    },
    {
      "library": "vue@3.5.43",
      "destination": "wwwroot/lib/vue/",
      "files": [ "dist/vue.global.prod.js" ]
    },
    {
      "library": "@fontsource-variable/inter@5.2.8",
      "destination": "wwwroot/lib/inter/",
      "files": [ "files/inter-latin-wght-normal.woff2", "files/inter-latin-ext-wght-normal.woff2" ]
    },
    {
      "library": "tabulator-tables@6.5.3",
      "destination": "wwwroot/lib/tabulator/",
      "files": [ "dist/js/tabulator.min.js", "dist/css/tabulator_bootstrap5.min.css" ]
    }
  ]
}
