<!-- Champs du formulaire client (ex-partielle _ChampsClient.cshtml) ; DataContext : ChampsClientViewModel. -->
<UserControl x:Class="erpWpf.Wpf.Controles.ChampsClient"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:erpWpf.Wpf.ViewModels.Clients"
             xmlns:clients="clr-namespace:erpWeb.Core.Clients;assembly=erpWeb.Core"
             mc:Ignorable="d" d:DataContext="{d:DesignInstance vm:ChampsClientViewModel}">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="16" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.ColumnSpan="3">
            <TextBlock Text="Raison sociale *" Style="{StaticResource TexteLibelle}" />
            <TextBox Text="{Binding RaisonSociale, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Raison sociale"
                     MaxLength="{x:Static clients:LongueursClient.RaisonSociale}" />
        </StackPanel>
        <StackPanel Grid.Row="1">
            <TextBlock Text="Adresse" Style="{StaticResource TexteLibelle}" />
            <TextBox Text="{Binding Adresse1, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Adresse"
                     MaxLength="{x:Static clients:LongueursClient.Adresse}" />
        </StackPanel>
        <StackPanel Grid.Row="1" Grid.Column="2">
            <TextBlock Text="Complément d'adresse" Style="{StaticResource TexteLibelle}" />
            <TextBox Text="{Binding Adresse2, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Complément d'adresse"
                     MaxLength="{x:Static clients:LongueursClient.Adresse}" />
        </StackPanel>
        <StackPanel Grid.Row="2">
            <TextBlock Text="Code postal" Style="{StaticResource TexteLibelle}" />
            <TextBox Text="{Binding CodePostal, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Code postal"
                     MaxLength="{x:Static clients:LongueursClient.CodePostal}" />
        </StackPanel>
        <StackPanel Grid.Row="2" Grid.Column="2">
            <TextBlock Text="Ville" Style="{StaticResource TexteLibelle}" />
            <TextBox Text="{Binding Ville, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Ville"
                     MaxLength="{x:Static clients:LongueursClient.Ville}" />
        </StackPanel>
        <StackPanel Grid.Row="3">
            <TextBlock Text="Pays" Style="{StaticResource TexteLibelle}" />
            <TextBox Text="{Binding Pays, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Pays"
                     MaxLength="{x:Static clients:LongueursClient.Pays}" />
        </StackPanel>
        <StackPanel Grid.Row="3" Grid.Column="2">
            <TextBlock Text="Email" Style="{StaticResource TexteLibelle}" />
            <TextBox Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Email"
                     MaxLength="{x:Static clients:LongueursClient.Email}" />
        </StackPanel>
        <StackPanel Grid.Row="4">
            <TextBlock Text="Téléphone" Style="{StaticResource TexteLibelle}" />
            <TextBox Text="{Binding Telephone1, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Téléphone"
                     MaxLength="{x:Static clients:LongueursClient.SaisieTelephone}" />
        </StackPanel>
        <StackPanel Grid.Row="4" Grid.Column="2">
            <TextBlock Text="Téléphone secondaire" Style="{StaticResource TexteLibelle}" />
            <TextBox Text="{Binding Telephone2, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Téléphone secondaire"
                     MaxLength="{x:Static clients:LongueursClient.SaisieTelephone}" />
        </StackPanel>
    </Grid>
</UserControl>
