<!-- Association ViewModel → vue : chaque écran ajoute ici son DataTemplate (résolution implicite par DataType). -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:compte="clr-namespace:erpWpf.Wpf.ViewModels.Compte"
                    xmlns:vuesCompte="clr-namespace:erpWpf.Wpf.Views.Compte"
                    xmlns:tableauDeBord="clr-namespace:erpWpf.Wpf.ViewModels.TableauDeBord"
                    xmlns:vuesTableauDeBord="clr-namespace:erpWpf.Wpf.Views.TableauDeBord"
                    xmlns:clients="clr-namespace:erpWpf.Wpf.ViewModels.Clients"
                    xmlns:vuesclients="clr-namespace:erpWpf.Wpf.Views.Clients">

    <DataTemplate DataType="{x:Type compte:ConnexionViewModel}">
        <vuesCompte:ConnexionVue />
    </DataTemplate>
    <DataTemplate DataType="{x:Type compte:InscriptionViewModel}">
        <vuesCompte:InscriptionVue />
    </DataTemplate>
    <DataTemplate DataType="{x:Type compte:AccesRefuseViewModel}">
        <vuesCompte:AccesRefuseVue />
    </DataTemplate>

    <DataTemplate DataType="{x:Type tableauDeBord:TableauDeBordViewModel}">
        <vuesTableauDeBord:TableauDeBordVue />
    </DataTemplate>

    <DataTemplate DataType="{x:Type clients:ListeClientsViewModel}">
        <vuesclients:ListeClientsVue />
    </DataTemplate>

    <DataTemplate DataType="{x:Type clients:EditionClientViewModel}">
        <vuesclients:EditionClientVue />
    </DataTemplate>

</ResourceDictionary>
