<!-- Association ViewModel → vue : chaque écran ajoute ici son DataTemplate (résolution implicite par DataType). -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:compte="clr-namespace:erpWpf.Wpf.ViewModels.Compte"
                    xmlns:vuesCompte="clr-namespace:erpWpf.Wpf.Views.Compte">

    <DataTemplate DataType="{x:Type compte:ConnexionViewModel}">
        <vuesCompte:ConnexionVue />
    </DataTemplate>
    <DataTemplate DataType="{x:Type compte:InscriptionViewModel}">
        <vuesCompte:InscriptionVue />
    </DataTemplate>
    <DataTemplate DataType="{x:Type compte:AccesRefuseViewModel}">
        <vuesCompte:AccesRefuseVue />
    </DataTemplate>

</ResourceDictionary>
