<UserControl x:Class="erpWpf.Wpf.Views.Compte.ConnexionVue"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:erpWpf.Wpf.ViewModels.Compte"
             xmlns:comportements="clr-namespace:erpWpf.Wpf.Comportements"
             mc:Ignorable="d" d:DataContext="{d:DesignInstance vm:ConnexionViewModel}"
             FocusManager.FocusedElement="{Binding ElementName=ChampEmail}">
    <StackPanel>
        <TextBlock Text="{Binding Titre}" Style="{StaticResource TexteTitre}" Margin="0,0,0,12" />
        <ItemsControl ItemsSource="{Binding Erreurs}" Style="{StaticResource ResumeErreurs}" />

        <TextBlock Text="Email" Style="{StaticResource TexteLibelle}" />
        <TextBox x:Name="ChampEmail" Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Email" />

        <TextBlock Text="Mot de passe" Style="{StaticResource TexteLibelle}" />
        <PasswordBox comportements:LiaisonMotDePasse.MotDePasse="{Binding MotDePasse, UpdateSourceTrigger=PropertyChanged}"
                     AutomationProperties.Name="Mot de passe" />

        <Button Content="Se connecter" Style="{StaticResource BoutonPrincipal}" IsDefault="True" Margin="0,20,0,0"
                Command="{Binding ConnecterCommand}" HorizontalAlignment="Stretch" />
    </StackPanel>
</UserControl>
