<UserControl x:Class="erpWpf.Wpf.Views.Compte.InscriptionVue"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:erpWpf.Wpf.ViewModels.Compte"
             xmlns:comportements="clr-namespace:erpWpf.Wpf.Comportements"
             mc:Ignorable="d" d:DataContext="{d:DesignInstance vm:InscriptionViewModel}">
    <StackPanel>
        <TextBlock Text="{Binding Titre}" Style="{StaticResource TexteTitre}" Margin="0,0,0,12" />
        <ItemsControl ItemsSource="{Binding Erreurs}" Style="{StaticResource ResumeErreurs}" />

        <TextBlock Text="Nom complet" Style="{StaticResource TexteLibelle}" />
        <TextBox Text="{Binding NomComplet, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Nom complet" />

        <TextBlock Text="Email" Style="{StaticResource TexteLibelle}" />
        <TextBox Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Email" />

        <TextBlock Text="Mot de passe" Style="{StaticResource TexteLibelle}" />
        <PasswordBox comportements:LiaisonMotDePasse.MotDePasse="{Binding MotDePasse, UpdateSourceTrigger=PropertyChanged}"
                     AutomationProperties.Name="Mot de passe" />
        <TextBlock Style="{StaticResource TexteSecondaire}" FontSize="11" Margin="0,3,0,0"
                   Text="8 caractères minimum, avec une majuscule, une minuscule, un chiffre et un caractère spécial." />

        <TextBlock Text="Confirmation du mot de passe" Style="{StaticResource TexteLibelle}" />
        <PasswordBox comportements:LiaisonMotDePasse.MotDePasse="{Binding ConfirmationMotDePasse, UpdateSourceTrigger=PropertyChanged}"
                     AutomationProperties.Name="Confirmation du mot de passe" />

        <Button Content="Créer mon compte" Style="{StaticResource BoutonPrincipal}" IsDefault="True" Margin="0,20,0,0"
                Command="{Binding InscrireCommand}" />
    </StackPanel>
</UserControl>
