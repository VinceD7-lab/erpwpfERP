<UserControl x:Class="erpWpf.Wpf.Views.Documents.ListeDocumentsVue"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:erpWpf.Wpf.ViewModels.Documents"
             xmlns:controles="clr-namespace:erpWpf.Wpf.Controles"
             mc:Ignorable="d" d:DataContext="{d:DesignInstance vm:ListeDocumentsViewModel}">
    <UserControl.Resources>
        <controles:ProxyLiaison x:Key="Ecran" Donnees="{Binding}" />
    </UserControl.Resources>

    <DockPanel>
        <controles:EnTetePage DockPanel.Dock="Top" Titre="{Binding Titre}">
            <Button Style="{StaticResource BoutonPrincipal}" Command="{Binding DeposerCommand}"
                    Visibility="{Binding PeutDeposer, Converter={StaticResource BooleenVersVisibilite}}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Style="{StaticResource Icone}" Text="{Binding Source=depot, Converter={StaticResource NomIconeVersGlyphe}}" Margin="0,0,6,0" />
                    <TextBlock Text="Déposer" />
                </StackPanel>
            </Button>
        </controles:EnTetePage>

        <WrapPanel DockPanel.Dock="Top" Style="{StaticResource BarreFiltres}">
            <StackPanel Style="{StaticResource ChampFiltre}">
                <TextBlock Text="Type d'entité" Style="{StaticResource TexteLibelle}" />
                <TextBox Text="{Binding TypeEntite, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Type d'entité" />
            </StackPanel>
            <StackPanel Style="{StaticResource ChampFiltre}">
                <TextBlock Text="Identifiant" Style="{StaticResource TexteLibelle}" />
                <TextBox Text="{Binding IdEntite, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Identifiant d'entité" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom" Margin="0,0,0,4">
                <Button Content="Filtrer" Style="{StaticResource BoutonPrincipal}" IsDefault="True" Command="{Binding FiltrerCommand}" Margin="0,0,8,0" />
                <Button Content="Réinitialiser" Command="{Binding ReinitialiserCommand}" />
            </StackPanel>
        </WrapPanel>

        <DataGrid ItemsSource="{Binding Documents}" AutomationProperties.Name="Liste des documents">
            <DataGrid.Columns>
                <DataGridTemplateColumn Header="Fichier" Width="2*" SortMemberPath="NomFichier">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Button Style="{StaticResource BoutonLien}" Padding="0" HorizontalAlignment="Left" Content="{Binding NomFichier}"
                                    Command="{Binding Donnees.TelechargerCommand, Source={StaticResource Ecran}}" CommandParameter="{Binding}"
                                    ToolTip="Télécharger" AutomationProperties.Name="{Binding NomFichier, StringFormat='Télécharger {0}'}" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="Entité" Width="*" SortMemberPath="TypeEntite">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock>
                                <Run Text="{Binding TypeEntite, Mode=OneWay}" /> #<Run Text="{Binding IdEntite, Mode=OneWay}" />
                            </TextBlock>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="Taille" Binding="{Binding Taille, Converter={StaticResource TailleVersKilooctets}}" SortMemberPath="Taille" Width="90" />
                <DataGridTextColumn Header="Déposé le" Binding="{Binding DateCreation, Converter={StaticResource UtcVersLocal}}" SortMemberPath="DateCreation" Width="130" />
                <DataGridTextColumn Header="Par" Binding="{Binding CreePar}" Width="*" />
                <DataGridTemplateColumn Header="" Width="Auto" CanUserSort="False"
                                        Visibility="{Binding Donnees.PeutSupprimer, Source={StaticResource Ecran}, Converter={StaticResource BooleenVersVisibilite}}">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Button Style="{StaticResource BoutonIcone}" Background="Transparent" BorderThickness="0" Padding="4" MinHeight="24"
                                    Foreground="{StaticResource PinceauDanger}"
                                    Content="{Binding Source=supprimer, Converter={StaticResource NomIconeVersGlyphe}}"
                                    Command="{Binding Donnees.SupprimerCommand, Source={StaticResource Ecran}}" CommandParameter="{Binding}"
                                    ToolTip="Supprimer" AutomationProperties.Name="{Binding NomFichier, StringFormat='Supprimer {0}'}" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</UserControl>
