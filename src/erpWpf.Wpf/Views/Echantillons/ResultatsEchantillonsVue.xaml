<UserControl x:Class="erpWpf.Wpf.Views.Echantillons.ResultatsEchantillonsVue"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:erpWpf.Wpf.ViewModels.Echantillons"
             xmlns:controles="clr-namespace:erpWpf.Wpf.Controles"
             xmlns:comportements="clr-namespace:erpWpf.Wpf.Comportements"
             xmlns:convertisseurs="clr-namespace:erpWpf.Wpf.Ressources.Convertisseurs"
             mc:Ignorable="d" d:DataContext="{d:DesignInstance vm:ResultatsEchantillonsViewModel}">
    <UserControl.Resources>
        <convertisseurs:GroupeEchantillon x:Key="GroupeEchantillon" />
        <CollectionViewSource x:Key="LignesGroupees" Source="{Binding Elements}">
            <CollectionViewSource.GroupDescriptions>
                <PropertyGroupDescription Converter="{StaticResource GroupeEchantillon}" />
            </CollectionViewSource.GroupDescriptions>
        </CollectionViewSource>
    </UserControl.Resources>

    <DockPanel>
        <controles:EnTetePage DockPanel.Dock="Top" Titre="{Binding Titre}" />

        <WrapPanel DockPanel.Dock="Top" Style="{StaticResource BarreFiltres}">
            <StackPanel Style="{StaticResource ChampFiltre}">
                <TextBlock Text="Tournées du" Style="{StaticResource TexteLibelle}" />
                <DatePicker SelectedDate="{Binding DateTourneeDebut}" AutomationProperties.Name="Tournées du" />
            </StackPanel>
            <StackPanel Style="{StaticResource ChampFiltre}">
                <TextBlock Text="au" Style="{StaticResource TexteLibelle}" />
                <DatePicker SelectedDate="{Binding DateTourneeFin}" AutomationProperties.Name="Tournées au" />
            </StackPanel>
            <StackPanel Style="{StaticResource ChampFiltre}" MinWidth="220">
                <TextBlock Text="Client" Style="{StaticResource TexteLibelle}" />
                <ComboBox ItemsSource="{Binding Clients}" DisplayMemberPath="Libelle" SelectedValuePath="Valeur"
                          SelectedValue="{Binding IdClient}" AutomationProperties.Name="Client" />
            </StackPanel>
            <StackPanel Style="{StaticResource ChampFiltre}">
                <TextBlock Text="Statut" Style="{StaticResource TexteLibelle}" />
                <ComboBox ItemsSource="{Binding Statuts}" DisplayMemberPath="Libelle" SelectedValuePath="Valeur"
                          SelectedValue="{Binding StatutAnalyse}" AutomationProperties.Name="Statut d'analyse" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom" Margin="0,0,0,4">
                <Button Content="Filtrer" Style="{StaticResource BoutonPrincipal}" IsDefault="True" Command="{Binding FiltrerCommand}" Margin="0,0,8,0" />
                <Button Content="Réinitialiser" Command="{Binding ReinitialiserCommand}" />
            </StackPanel>
        </WrapPanel>

        <controles:BarrePagination DockPanel.Dock="Bottom" />

        <Grid>
            <DataGrid ItemsSource="{Binding Source={StaticResource LignesGroupees}}"
                      comportements:TriServeur.Commande="{Binding TrierCommand}"
                      comportements:TriServeur.ColonneTriee="{Binding Tri}"
                      comportements:TriServeur.Descendant="{Binding TriDescendant}"
                      AutomationProperties.Name="Résultats des échantillons">
                <DataGrid.GroupStyle>
                    <GroupStyle>
                        <GroupStyle.HeaderTemplate>
                            <DataTemplate>
                                <Border Background="#FFEFF3F8" Padding="8,5">
                                    <TextBlock FontWeight="SemiBold">
                                        <Run Text="{Binding Name, Mode=OneWay}" /> (<Run Text="{Binding ItemCount, Mode=OneWay}" />)
                                    </TextBlock>
                                </Border>
                            </DataTemplate>
                        </GroupStyle.HeaderTemplate>
                    </GroupStyle>
                </DataGrid.GroupStyle>
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Code-barres" Binding="{Binding CodeBarresAnonyme}" SortMemberPath="CodeBarres" Width="170" />
                    <DataGridTextColumn Header="Filière" Binding="{Binding Filiere}" SortMemberPath="Filiere" Width="130" />
                    <DataGridTemplateColumn Header="Statut" SortMemberPath="StatutAnalyse" Width="90">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <ContentControl Content="{Binding StatutAnalyse}" ContentTemplate="{StaticResource ModeleBadge}" Focusable="False" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="Support" Binding="{Binding TypeSupport}" CanUserSort="False" Width="120" />
                    <DataGridTextColumn Header="T° réception (°C)" Binding="{Binding TemperatureReception, StringFormat='0.###'}" CanUserSort="False" Width="Auto" />
                    <DataGridTextColumn Header="pH sol" Binding="{Binding PhSol, StringFormat='0.###'}" CanUserSort="False" Width="Auto" />
                    <DataGridTextColumn Header="Matière organique" Binding="{Binding MatiereOrganique, StringFormat='0.###'}" CanUserSort="False" Width="Auto" />
                    <DataGridTextColumn Header="P2O5" Binding="{Binding PhosphoreP2O5, StringFormat='0.###'}" CanUserSort="False" Width="Auto" />
                    <DataGridTextColumn Header="K2O" Binding="{Binding PotassiumK2O, StringFormat='0.###'}" CanUserSort="False" Width="Auto" />
                    <DataGridTextColumn Header="Reliquat N" Binding="{Binding ReliquatAzoteN, StringFormat='0.###'}" CanUserSort="False" Width="Auto" />
                    <DataGridTextColumn Header="UCL fourrage" Binding="{Binding ValeurUclFourrage, StringFormat='0.###'}" CanUserSort="False" Width="Auto" />
                    <DataGridTextColumn Header="Validation" Binding="{Binding DateValidation, StringFormat='dd/MM/yyyy HH:mm'}" CanUserSort="False" Width="120" />
                </DataGrid.Columns>
            </DataGrid>
            <ProgressBar IsIndeterminate="True" Height="3" VerticalAlignment="Top"
                         Visibility="{Binding EstOccupe, Converter={StaticResource BooleenVersVisibilite}}" />
        </Grid>
    </DockPanel>
</UserControl>
