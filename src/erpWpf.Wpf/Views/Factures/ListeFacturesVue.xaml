<UserControl x:Class="erpWpf.Wpf.Views.Factures.ListeFacturesVue"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:erpWpf.Wpf.ViewModels.Factures"
             xmlns:controles="clr-namespace:erpWpf.Wpf.Controles"
             xmlns:comportements="clr-namespace:erpWpf.Wpf.Comportements"
             mc:Ignorable="d" d:DataContext="{d:DesignInstance vm:ListeFacturesViewModel}">
    <UserControl.Resources>
        <controles:ProxyLiaison x:Key="Ecran" Donnees="{Binding}" />
        <Style x:Key="Montant" TargetType="TextBlock">
            <Setter Property="HorizontalAlignment" Value="Right" />
        </Style>
    </UserControl.Resources>

    <DockPanel>
        <controles:EnTetePage DockPanel.Dock="Top" Titre="{Binding Titre}">
            <Button Style="{StaticResource BoutonPrincipal}" Command="{Binding GenererCommand}"
                    Visibility="{Binding PeutGenerer, Converter={StaticResource BooleenVersVisibilite}}"
                    Content="Générer les factures manquantes" />
        </controles:EnTetePage>

        <WrapPanel DockPanel.Dock="Top" Style="{StaticResource BarreFiltres}">
            <StackPanel Style="{StaticResource ChampFiltre}">
                <TextBlock Text="Factures du" Style="{StaticResource TexteLibelle}" />
                <DatePicker SelectedDate="{Binding DateFactureDebut}" AutomationProperties.Name="Factures du" />
            </StackPanel>
            <StackPanel Style="{StaticResource ChampFiltre}">
                <TextBlock Text="au" Style="{StaticResource TexteLibelle}" />
                <DatePicker SelectedDate="{Binding DateFactureFin}" AutomationProperties.Name="Factures au" />
            </StackPanel>
            <StackPanel Style="{StaticResource ChampFiltre}" MinWidth="220">
                <TextBlock Text="Client" Style="{StaticResource TexteLibelle}" />
                <ComboBox ItemsSource="{Binding Clients}" DisplayMemberPath="Libelle" SelectedValuePath="Valeur"
                          SelectedValue="{Binding IdClient}" AutomationProperties.Name="Client" />
            </StackPanel>
            <StackPanel Style="{StaticResource ChampFiltre}">
                <TextBlock Text="Statut" Style="{StaticResource TexteLibelle}" />
                <ComboBox ItemsSource="{Binding Statuts}" DisplayMemberPath="Libelle" SelectedValuePath="Valeur"
                          SelectedValue="{Binding StatutFacture}" AutomationProperties.Name="Statut de facture" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom" Margin="0,0,0,4">
                <Button Content="Filtrer" Style="{StaticResource BoutonPrincipal}" IsDefault="True" Command="{Binding FiltrerCommand}" Margin="0,0,8,0" />
                <Button Content="Réinitialiser" Command="{Binding ReinitialiserCommand}" />
            </StackPanel>
        </WrapPanel>

        <controles:BarrePagination DockPanel.Dock="Bottom" />

        <Grid>
            <DataGrid ItemsSource="{Binding Elements}" FrozenColumnCount="1"
                      comportements:TriServeur.Commande="{Binding TrierCommand}"
                      comportements:TriServeur.ColonneTriee="{Binding Tri}"
                      comportements:TriServeur.Descendant="{Binding TriDescendant}"
                      HorizontalScrollBarVisibility="Auto"
                      AutomationProperties.Name="Liste des factures">
                <DataGrid.Columns>
                    <DataGridTemplateColumn Header="" CanUserSort="False" Width="Auto">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Button Style="{StaticResource BoutonIcone}" Background="Transparent" BorderThickness="0" Padding="4" MinHeight="24"
                                        Content="{Binding Source=imprimer, Converter={StaticResource NomIconeVersGlyphe}}"
                                        Command="{Binding Donnees.ImprimerCommand, Source={StaticResource Ecran}}" CommandParameter="{Binding}"
                                        ToolTip="Imprimer" AutomationProperties.Name="{Binding NumeroFacture, StringFormat='Imprimer la facture {0}'}" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="N°" Binding="{Binding NumeroFacture, StringFormat=D6}" SortMemberPath="NumeroFacture" />
                    <DataGridTextColumn Header="Date" Binding="{Binding DateFacture, StringFormat=d}" SortMemberPath="DateFacture" />
                    <DataGridTextColumn Header="Échéance" Binding="{Binding DateEcheance, StringFormat=d}" SortMemberPath="DateEcheance" />
                    <DataGridTextColumn Header="Code client" Binding="{Binding CodeClient}" CanUserSort="False" />
                    <DataGridTextColumn Header="Client" Binding="{Binding NomClient}" SortMemberPath="Client" MinWidth="160" />
                    <DataGridTextColumn Header="Adresse" Binding="{Binding AdresseFacturation}" CanUserSort="False" MaxWidth="220" />
                    <DataGridTextColumn Header="CP" Binding="{Binding CodePostal}" CanUserSort="False" />
                    <DataGridTextColumn Header="Ville" Binding="{Binding Ville}" CanUserSort="False" />
                    <DataGridTextColumn Header="Pays" Binding="{Binding Pays}" CanUserSort="False" />
                    <DataGridTextColumn Header="Paiement" Binding="{Binding ModePaiement}" CanUserSort="False" />
                    <DataGridTextColumn Header="HT" Binding="{Binding MontantHorsTaxe, StringFormat=N2}" CanUserSort="False" ElementStyle="{StaticResource Montant}" />
                    <DataGridTextColumn Header="TVA %" Binding="{Binding TauxTva, StringFormat='0.##'}" CanUserSort="False" ElementStyle="{StaticResource Montant}" />
                    <DataGridTextColumn Header="Montant TVA" Binding="{Binding MontantTva, StringFormat=N2}" CanUserSort="False" ElementStyle="{StaticResource Montant}" />
                    <DataGridTextColumn Header="TTC" Binding="{Binding MontantToutesTaxesComprises, StringFormat=N2}" SortMemberPath="MontantToutesTaxesComprises" ElementStyle="{StaticResource Montant}" />
                    <DataGridTextColumn Header="Remise %" Binding="{Binding Remise, StringFormat='0.##'}" CanUserSort="False" ElementStyle="{StaticResource Montant}" />
                    <DataGridTextColumn Header="Devise" Binding="{Binding Devise}" CanUserSort="False" />
                    <DataGridTemplateColumn Header="Statut" SortMemberPath="StatutFacture">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <ContentControl Content="{Binding StatutFacture}" ContentTemplate="{StaticResource ModeleBadge}" Focusable="False" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="Date paiement" Binding="{Binding DatePaiement, StringFormat=d}" CanUserSort="False" />
                    <DataGridTextColumn Header="Commentaire" Binding="{Binding Commentaire}" CanUserSort="False" MaxWidth="260" />
                </DataGrid.Columns>
            </DataGrid>
            <ProgressBar IsIndeterminate="True" Height="3" VerticalAlignment="Top"
                         Visibility="{Binding EstOccupe, Converter={StaticResource BooleenVersVisibilite}}" />
        </Grid>
    </DockPanel>
</UserControl>
