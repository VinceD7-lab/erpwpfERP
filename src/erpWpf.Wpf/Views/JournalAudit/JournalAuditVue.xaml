<UserControl x:Class="erpWpf.Wpf.Views.JournalAudit.JournalAuditVue"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:erpWpf.Wpf.ViewModels.JournalAudit"
             xmlns:controles="clr-namespace:erpWpf.Wpf.Controles"
             xmlns:comportements="clr-namespace:erpWpf.Wpf.Comportements"
             mc:Ignorable="d" d:DataContext="{d:DesignInstance vm:JournalAuditViewModel}">
    <DockPanel>
        <controles:EnTetePage DockPanel.Dock="Top" Titre="{Binding Titre}">
            <Button Command="{Binding ExporterCommand}" Visibility="{Binding PeutExporter, Converter={StaticResource BooleenVersVisibilite}}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Style="{StaticResource Icone}" Text="{Binding Source=exporter, Converter={StaticResource NomIconeVersGlyphe}}" Margin="0,0,6,0" />
                    <TextBlock Text="Exporter (Excel)" />
                </StackPanel>
            </Button>
        </controles:EnTetePage>

        <WrapPanel DockPanel.Dock="Top" Style="{StaticResource BarreFiltres}">
            <StackPanel Style="{StaticResource ChampFiltre}" MinWidth="240">
                <TextBlock Text="Recherche" Style="{StaticResource TexteLibelle}" />
                <TextBox Text="{Binding Recherche, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Recherche (utilisateur, entité, identifiant)"
                         ToolTip="Utilisateur, type d'entité ou identifiant" />
            </StackPanel>
            <StackPanel Style="{StaticResource ChampFiltre}">
                <TextBlock Text="Action" Style="{StaticResource TexteLibelle}" />
                <ComboBox ItemsSource="{Binding Actions}" DisplayMemberPath="Libelle" SelectedValuePath="Valeur"
                          SelectedValue="{Binding Action}" AutomationProperties.Name="Action" />
            </StackPanel>
            <StackPanel Style="{StaticResource ChampFiltre}">
                <TextBlock Text="Du" Style="{StaticResource TexteLibelle}" />
                <DatePicker SelectedDate="{Binding DateDebut}" AutomationProperties.Name="Du" />
            </StackPanel>
            <StackPanel Style="{StaticResource ChampFiltre}">
                <TextBlock Text="Au" Style="{StaticResource TexteLibelle}" />
                <DatePicker SelectedDate="{Binding DateFin}" AutomationProperties.Name="Au" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom" Margin="0,0,0,4">
                <Button Content="Filtrer" Style="{StaticResource BoutonPrincipal}" IsDefault="True" Command="{Binding FiltrerCommand}" Margin="0,0,8,0" />
                <Button Content="Réinitialiser" Command="{Binding ReinitialiserCommand}" />
            </StackPanel>
        </WrapPanel>

        <controles:BarrePagination DockPanel.Dock="Bottom" />

        <Grid>
            <DataGrid ItemsSource="{Binding Elements}" RowDetailsVisibilityMode="VisibleWhenSelected"
                      comportements:TriServeur.Commande="{Binding TrierCommand}"
                      comportements:TriServeur.ColonneTriee="{Binding Tri}"
                      comportements:TriServeur.Descendant="{Binding TriDescendant}"
                      AutomationProperties.Name="Entrées du journal d'audit">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Date" Binding="{Binding Date, Converter={StaticResource UtcVersLocal}, ConverterParameter='dd/MM/yyyy HH:mm:ss'}" SortMemberPath="Date" Width="150" />
                    <DataGridTextColumn Header="Utilisateur" Binding="{Binding Utilisateur}" SortMemberPath="Utilisateur" Width="*" />
                    <DataGridTemplateColumn Header="Action" SortMemberPath="Action" Width="110">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <ContentControl Content="{Binding Action}" ContentTemplate="{StaticResource ModeleBadge}" Focusable="False" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="Entité" Binding="{Binding TypeEntite}" SortMemberPath="TypeEntite" Width="*" />
                    <DataGridTextColumn Header="Identifiant" Binding="{Binding IdEntite}" CanUserSort="False" Width="*" />
                    <DataGridTextColumn Header="Détails" Binding="{Binding Source='Sélectionner la ligne'}" CanUserSort="False" Width="140"
                                        Foreground="{StaticResource PinceauTexteSecondaire}" />
                </DataGrid.Columns>
                <DataGrid.RowDetailsTemplate>
                    <DataTemplate>
                        <Grid Margin="12,6" MaxHeight="260">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Top" Text="Avant" FontWeight="SemiBold" Margin="0,0,0,4" />
                                <TextBox Text="{Binding AnciennesValeurs, Mode=OneWay, TargetNullValue='—'}" IsReadOnly="True" FontFamily="Consolas"
                                         TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" AutomationProperties.Name="Valeurs avant" />
                            </DockPanel>
                            <DockPanel Grid.Column="2">
                                <TextBlock DockPanel.Dock="Top" Text="Après" FontWeight="SemiBold" Margin="0,0,0,4" />
                                <TextBox Text="{Binding NouvellesValeurs, Mode=OneWay, TargetNullValue='—'}" IsReadOnly="True" FontFamily="Consolas"
                                         TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" AutomationProperties.Name="Valeurs après" />
                            </DockPanel>
                        </Grid>
                    </DataTemplate>
                </DataGrid.RowDetailsTemplate>
            </DataGrid>
            <ProgressBar IsIndeterminate="True" Height="3" VerticalAlignment="Top"
                         Visibility="{Binding EstOccupe, Converter={StaticResource BooleenVersVisibilite}}" />
        </Grid>
    </DockPanel>
</UserControl>
