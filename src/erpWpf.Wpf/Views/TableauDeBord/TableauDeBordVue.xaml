<UserControl x:Class="erpWpf.Wpf.Views.TableauDeBord.TableauDeBordVue"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:erpWpf.Wpf.ViewModels.TableauDeBord"
             xmlns:vues="clr-namespace:erpWpf.Wpf.Views.TableauDeBord"
             xmlns:controles="clr-namespace:erpWpf.Wpf.Controles"
             mc:Ignorable="d" d:DataContext="{d:DesignInstance vm:TableauDeBordViewModel}">
    <DockPanel>
        <controles:EnTetePage DockPanel.Dock="Top" Titre="{Binding Titre}" />
        <TextBlock DockPanel.Dock="Top" Style="{StaticResource TexteSecondaire}"
                   Text="Aucun widget n'est disponible pour votre profil."
                   Visibility="{Binding EstVide, Converter={StaticResource BooleenVersVisibilite}}" />
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding Widgets}" Focusable="False">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Columns="2" VerticalAlignment="Top" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:WidgetViewModel}">
                        <vues:WidgetVue />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </DockPanel>
</UserControl>
