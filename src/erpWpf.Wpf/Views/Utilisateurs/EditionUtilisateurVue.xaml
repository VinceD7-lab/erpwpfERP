<UserControl x:Class="erpWpf.Wpf.Views.Utilisateurs.EditionUtilisateurVue"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:erpWpf.Wpf.ViewModels.Utilisateurs"
             xmlns:controles="clr-namespace:erpWpf.Wpf.Controles"
             xmlns:comportements="clr-namespace:erpWpf.Wpf.Comportements"
             mc:Ignorable="d" d:DataContext="{d:DesignInstance vm:EditionUtilisateurViewModel}">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel MaxWidth="640" HorizontalAlignment="Left">
            <controles:EnTetePage Titre="{Binding Titre}" />
            <ItemsControl ItemsSource="{Binding Erreurs}" Style="{StaticResource ResumeErreurs}" />

            <Border Style="{StaticResource Carte}">
                <StackPanel>
                    <TextBlock Text="Informations" Style="{StaticResource TexteSousTitre}" />
                    <TextBlock Text="Nom complet" Style="{StaticResource TexteLibelle}" />
                    <TextBox Text="{Binding NomComplet, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Nom complet" />
                    <TextBlock Text="Email" Style="{StaticResource TexteLibelle}" />
                    <TextBox Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Email" />

                    <StackPanel Visibility="{Binding EstCreation, Converter={StaticResource BooleenVersVisibilite}}">
                        <TextBlock Text="Mot de passe initial" Style="{StaticResource TexteLibelle}" />
                        <PasswordBox comportements:LiaisonMotDePasse.MotDePasse="{Binding MotDePasse, UpdateSourceTrigger=PropertyChanged}"
                                     AutomationProperties.Name="Mot de passe initial" />
                    </StackPanel>

                    <TextBlock Text="Rôles" Style="{StaticResource TexteLibelle}" />
                    <ItemsControl ItemsSource="{Binding Roles}" Focusable="False">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:SelectionRoleViewModel}">
                                <CheckBox Content="{Binding Nom}" IsChecked="{Binding EstSelectionne}" Margin="0,3" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <StackPanel Orientation="Horizontal" Margin="0,20,0,0">
                        <Button Content="Enregistrer" Style="{StaticResource BoutonPrincipal}" Command="{Binding EnregistrerCommand}" Margin="0,0,8,0" />
                        <Button Content="Annuler" IsCancel="True" Command="{Binding AnnulerCommand}" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Carte}" Margin="0,16,0,0"
                    Visibility="{Binding EstCreation, Converter={StaticResource BooleenVersVisibilite}, ConverterParameter=Inverse}">
                <StackPanel>
                    <TextBlock Text="Réinitialiser le mot de passe" Style="{StaticResource TexteSousTitre}" />
                    <TextBlock Text="Nouveau mot de passe" Style="{StaticResource TexteLibelle}" />
                    <PasswordBox comportements:LiaisonMotDePasse.MotDePasse="{Binding NouveauMotDePasse, UpdateSourceTrigger=PropertyChanged}"
                                 AutomationProperties.Name="Nouveau mot de passe" />
                    <Button Content="Réinitialiser" Style="{StaticResource BoutonDanger}" HorizontalAlignment="Left" Margin="0,12,0,0"
                            Command="{Binding ReinitialiserMotDePasseCommand}" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
